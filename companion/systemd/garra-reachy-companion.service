[Unit]
Description=Garra Reachy — companion (administra a voz e a conexão com o robô)
Documentation=https://github.com/GarraIA/garra-reachy-mini
After=network-online.target
Wants=network-online.target
# Sem limite de reinícios: o companion é o único caminho do robô ao cérebro, e
# cinco quedas rápidas (uma porta ocupada por um teste manual) o deixariam
# `failed` até alguém rodar reset-failed. Em [Unit], onde o systemd lê isto.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/Documents/Projetos/Reachy-Mini-Control/garra_reachy_mini
Environment=PYTHONUNBUFFERED=1
# Opcional, do dono: GARRA_PONTE_MODELO=<modelo da voz no gateway>.
# O `-` faz a falta do arquivo não ser erro.
EnvironmentFile=-%h/.config/garra-reachy/companion.env
# Sem GPU e sem `ReachyMini`: este processo só fala HTTP e chama
# `systemctl --user`. O dono do robô continua sendo o app instalado nele.
ExecStart=%h/Documents/Projetos/Reachy-Mini-Control/reachy_mini_env/bin/python -m companion

# Leve o bastante para ficar sempre de pé: é ele que serve os controles da voz
# ao console em :3888, inclusive (e principalmente) quando a voz está parada.
Restart=always
RestartSec=5

UMask=0077
NoNewPrivileges=yes

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
