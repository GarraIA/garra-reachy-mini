# Copie para .env (fora do git!) ou exporte no ambiente do daemon.
# Chaves de API dos modos reserva — o gateway do Garra usa a própria config dele.
# Descomente e preencha a que você usa (o app ignora placeholders).
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Opções do app (todas opcionais) ─────────────────────────────────────────
# Configuráveis também pela página em :8042: GARRA_GATEWAY_URL, GARRA_GATEWAY_KEY,
# GARRA_VOZ_URL, GARRA_AGENT_ID, GARRA_GATEWAY_MODEL, GARRA_PROVIDER, GARRA_MODEL,
# GARRA_BIN e GARRA_HISTORICO_TURNOS. As demais são só por variável de ambiente.
# Comentário no fim da linha é aceito, mas prefira comentar na linha de cima.

# Modo wireless/dashboard no robô: aponte para o IP do SEU computador.
# GARRA_GATEWAY_URL=http://127.0.0.1:3888
# GARRA_VOZ_URL=http://127.0.0.1:8123

# Bearer do gateway (auto-lido do config.yml do Garra local, quando existe).
# GARRA_GATEWAY_KEY=

# GARRA_AGENT_ID=reachy_voice

# Vazio = modelo padrão do Garra.
# GARRA_GATEWAY_MODEL=

# Modo reserva (sem ferramentas).
# GARRA_PROVIDER=openrouter
# GARRA_MODEL=anthropic/claude-haiku-4.5

# Caminho do binário garra (vazio = descoberta automática).
# GARRA_BIN=

# GARRA_TIMEOUT_GATEWAY_S=120
# GARRA_TIMEOUT_ASK_S=60
# GARRA_HISTORICO_TURNOS=8
# GARRA_NOTIFICACOES_S=4.0

# Limiar de voz fixo (vazio = auto-calibrar pelo ruído ambiente).
# GARRA_LIMIAR=

# GARRA_REACHY_DIR=~/.config/garra_reachy_mini

# ── Robô: painel, API e comportamento ────────────────────────────────────────
# REST do daemon do robô (moves, apps, tracking). Padrão: reachy-mini.local:8000
#GARRA_ROBO_API=http://10.0.0.142:8000
# Porta do painel. Vazio = escolhe sozinho entre 8042..8046 (no desktop a 8042
# pertence ao reachy-mini-control da Pollen).
#GARRA_REACHY_PORTA=8043
# Acesso pela rede. Exige TOKEN: sem ele, a API fica no loopback com aviso.
#GARRA_REACHY_ALLOW_REMOTE=1
#GARRA_REACHY_TOKEN=gere_com_openssl_rand_hex_24
# Comportamento durante a conversa
#GARRA_COMPORTAMENTO_AMBIENTE=true
#GARRA_ATALHOS_LOCAIS=true
#GARRA_TRACKING_AMBIENTE=false
#GARRA_TRACKING_PESO=0.35
#GARRA_WOBBLING=true
#GARRA_CAMERA_FPS=12
