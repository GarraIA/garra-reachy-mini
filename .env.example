# Copy to ~/.config/garra_reachy_mini/.env (never into git) or export in the
# environment the robot daemon launches the app with.
#
# EVERY setting here is optional. With none of them, the robot is still fully
# controllable from the panel: head, antennas, expressions, dances, camera and
# native face tracking all work with no configuration at all. What these enable
# is conversation and speech.
#
# Placeholders such as `your_api_key_here` are treated as absent, so an
# unfinished copy of this file never makes the app call an API with a bad key.

# ── Conversation (optional) ──────────────────────────────────────────────────
# Pick ONE provider. Nothing is sent anywhere until you do.
# OPENROUTER_API_KEY=
# GARRA_MODEL=anthropic/claude-haiku-4.5

# Your own Garra gateway, if you run one. Takes precedence over OpenRouter.
# GARRA_GATEWAY_URL=http://127.0.0.1:3888
# GARRA_GATEWAY_KEY=
# GARRA_AGENT_ID=reachy_voice
# Empty = the gateway's own default model.
# GARRA_GATEWAY_MODEL=

# Your name, so the assistant can address you. Empty = no name.
# GARRA_USUARIO=

# ── Voice (optional) ─────────────────────────────────────────────────────────
# Companion speech server — see tools/servidor_voz.py. Speech-to-text and
# text-to-speech do not fit on the robot's CPU, so this runs on a GPU machine
# and the robot reaches it over the network.
# GARRA_VOZ_URL=http://192.0.2.10:8123

# Fixed voice threshold (empty = calibrate against ambient noise at start-up).
# GARRA_LIMIAR=

# ── Panel and network ────────────────────────────────────────────────────────
# Where the panel listens. Auto: 0.0.0.0 inside a wireless robot (the Pollen
# daemon is already open on the LAN there), loopback anywhere else. Set this to
# 127.0.0.1 to keep the panel strictly local.
# GARRA_REACHY_BIND=127.0.0.1
# Require a token on the API. Off by default on the robot, where the Pollen
# daemon is already open on the LAN without one. Set it to require a token
# anyway. Outside the robot it is generated automatically when you enable
# network access, and stored at ~/.config/garra_reachy_mini/token (mode 600).
# GARRA_REACHY_TOKEN=
# Panel port. Empty = 8042, falling back to 8043..8046 if taken (on a desktop
# 8042 usually belongs to Pollen's reachy-mini-control).
# GARRA_REACHY_PORTA=8042

# Robot daemon REST API. Auto: 127.0.0.1:8000 when there is a local daemon
# (an installed app runs inside the robot), reachy-mini.local:8000 otherwise.
# GARRA_ROBO_API=http://reachy-mini.local:8000

# Where settings, session state, token and captures live.
# GARRA_REACHY_DIR=~/.config/garra_reachy_mini

# ── Behaviour ────────────────────────────────────────────────────────────────
# GARRA_COMPORTAMENTO_AMBIENTE=true   # subtle movement during conversation
# GARRA_ATALHOS_LOCAIS=true           # "stop"/"dance" answer without the model
# GARRA_TRACKING_AMBIENTE=false       # look at the user while talking
# GARRA_TRACKING_PESO=0.35
# GARRA_WOBBLING=true                 # audio-reactive head sway while speaking
# GARRA_CAMERA_FPS=12

# ── Timeouts ─────────────────────────────────────────────────────────────────
# GARRA_TIMEOUT_GATEWAY_S=120
# GARRA_TIMEOUT_ASK_S=60
# GARRA_HISTORICO_TURNOS=8
# GARRA_NOTIFICACOES_S=4.0
# GARRA_BIN=
