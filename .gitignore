# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

# Secrets and local configuration — never commit
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.jks
credentials*
secrets*
config.json
*.token

# Runtime data produced by the app
capturas/
captures/
estado.json
*.log
*.db
*.sqlite*

# Media recorded or captured locally. assets/ is documentation, not runtime
# output, so it is deliberately excluded from these rules.
*.wav
*.mp3
*.ogg
*.mp4
*.webm
!assets/**

# Local tooling
bin/
garra-config/
node_modules/

# OS noise
.DS_Store
Thumbs.db
*~
*.swp

# Carimbo de build gerado pelo publicar.sh — nunca commitado:
# o SHA de um commit não pode viver dentro do próprio commit.
garra_reachy_mini/_commit.py
